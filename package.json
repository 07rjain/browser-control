{
  "name": "browser-control",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:release": "npm run build && node scripts/build-release.mjs",
    "build:release:bootstrap": "npm run build && node scripts/build-release.mjs --bootstrap",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bridge": "node scripts/smoke-native-host.mjs",
    "test:reviewer": "node scripts/probe-auto-review.mjs",
    "test:installed-host": "node scripts/smoke-installed-host.mjs",
    "test:release": "node scripts/smoke-release.mjs",
    "install:host": "node scripts/install-native-host.mjs",
    "uninstall:host": "node scripts/uninstall-native-host.mjs",
    "install:host:mac": "node scripts/install-native-host.mjs",
    "uninstall:host:mac": "node scripts/uninstall-native-host.mjs"
  },
  "dependencies": {
    "hast-util-from-html-isomorphic": "^2.0.0",
    "katex": "^0.16.47",
    "pdfjs-dist": "5.6.205",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
